VITE_PINATA_JWT=your_pinata_jwt_here

# Base URL of the external, independently-hosted delegation verifier (separate
# repo, pinned to IPFS). Used to deep-link out from a subscription's detail view.
# The external verifier's current IPFS CID URL. The CID changes on each re-pin of
# the verifier — update this (and redeploy) whenever the verifier is rebuilt.
# VITE_VERIFIER_URL=https://bafybeigja45di5agun7qdwaz3dqiyrrtrqbdm4thwhfgc6nc4fwtjkjuqu.ipfs.dweb.link/

# --- Safe App (frontend, VITE_ = bundled into the public browser build) ---

# URL of the Intuition publisher. In the default (same-app) deploy the publisher
# runs INSIDE the web container and Caddy serves it at /intuition, so the Docker
# build already defaults this to "/intuition" — you do NOT need to set it. Only
# override to point the Safe App at an external publisher service.
# VITE_INTUITION_PUBLISHER_URL=/intuition
# Which Intuition network the Safe App Charge page reads to list delegations made
# to the connected Safe: testnet (default, previews) or mainnet (prod).
VITE_INTUITION_NETWORK=testnet

# URL of the agent service. Defaults to /agent - the same-origin path Caddy
# reverse-proxies to the service running in this same container, so prod and every
# preview work with no config. Override only for an external agent service, or to
# point at a locally-run one during development.
# VITE_AGENT_SERVICE_URL=http://localhost:8789
# Optional: Uniswap's official subgraph endpoint + The Graph gateway API key,
# used by the Yield page to estimate pool APY from 24h fees/TVL. Best-effort —
# on-chain pool discovery (TVL, liquidity) works without these; APY just shows
# as "insufficient data" until they're set.
# VITE_UNISWAP_SUBGRAPH_URL=https://gateway.thegraph.com/api/subgraphs/id/...
# VITE_THEGRAPH_API_KEY=
# Optional shared secret sent as x-publish-secret (must match the backend's
# PUBLISH_SECRET). Note: any VITE_ value is public — this only deters drive-by use.
# VITE_INTUITION_PUBLISHER_SECRET=
# Public address of the dedicated Yield agent wallet (see scripts/yield-agent.ts).
# Just an address — safe to expose. The Yield page delegates to this address;
# leave unset to disable the "Delegate to agent" panel.
# VITE_YIELD_AGENT_ADDRESS=0xyour_yield_agent_wallet_address

# --- Website /redeem page (Next.js, NEXT_PUBLIC_ = inlined at build) ---
# Which Intuition network the redeem page reads to list delegations made to the
# connected wallet: testnet (default, previews) or mainnet (prod).
NEXT_PUBLIC_INTUITION_NETWORK=testnet

# --- Intuition publisher backend (server/intuition-publisher.ts) ---
# NODE-SIDE ONLY. Never prefix these with VITE_ — that would ship them to the
# browser. Set them on the publisher service (e.g. a Coolify backend service),
# NOT on the static Safe App.

# Funded attestor key. tTRUST (testnet) / $TRUST (mainnet). Writes the delegation
# atoms + triples and pays the fees. Also used by scripts/intuition-publish.ts.
INTUITION_ATTESTOR_PK=0xyour_funded_intuition_testnet_private_key
# Pins the DelegationJson document to IPFS (server-side; same Pinata account is fine).
PINATA_JWT=your_pinata_jwt_here
# Intuition pin API key. Pins atom metadata (things/orgs) via the Intuition pin
# API (pin.intuition.systems) — the read GraphQL endpoint serves no mutations.
# Keep server-side; never prefix with VITE_.
INTUITION_PIN_API_KEY=your_intuition_pin_api_key_here
# Target Intuition network: testnet (13579, default) or mainnet (1155).
INTUITION_NETWORK=testnet
# HTTP port for the publisher (own var so a platform PORT doesn.t repoint it).
INTUITION_PUBLISHER_PORT=8787

# --- Mandate assistant (server/mandate-assistant.ts) ---
# Turns a plain-language order into limit-order parameters via 0G Compute.
# NODE-SIDE ONLY. An sk- key spends your 0G deposit - never prefix with VITE_.
# Get one at https://pc.0g.ai -> Get API Key (deposit 0G first).
# OG_ROUTER_API_KEY=sk-your_0g_router_key
# Mainnet router by default; testnet only serves 2 models (qwen2.5-omni for chat).
# OG_ROUTER_URL=https://router-api.0g.ai/v1
# 0G's own model: cheap, TEE-attested (TDX), supports JSON output.
# OG_MODEL=0gm-1.0-35b-a3b
# Own port var so a platform PORT doesn't repoint it.
MANDATE_ASSISTANT_PORT=8788

# --- 0G agent service (server/og-agent-service.ts) ---
# Provisions an agent wallet, then lets a 0G Compute model drive the limit order.
# Runs inside the main container alongside the publisher (see entrypoint.sh), so it
# needs no separate deploy and no CORS - only OG_ROUTER_API_KEY + UNISWAP_API_KEY.
# Mount a PERSISTENT VOLUME on the runs dir: it holds agent private keys, and a
# mandate is signed to an agent address.
# Give each agent only enough ETH for one redeem: the mandate's caveats bound what a
# redeem can do, but nothing bounds a shell.
OG_AGENT_PORT=8789
# AGENT_RUNS_DIR=.agent-runs
# AGENT_MAX_STEPS=40
# Allowed CORS origins: comma-separated, supports `*` and subdomain wildcards.
# Default (when unset) accepts the apex + every PR preview subdomain + local dev:
#   https://hourglass.box,https://*.hourglass.box,http://localhost:5173
# ALLOWED_ORIGIN=https://hourglass.box,https://*.hourglass.box
# Optional: require this in the x-publish-secret header (matches VITE_INTUITION_PUBLISHER_SECRET).
# PUBLISH_SECRET=

# --- Yield agent (scripts/yield-agent.ts) ---
# NODE-SIDE ONLY, run locally by whoever operates the agent. Never prefix with
# VITE_, never commit — it spends real (testnet) gas from this wallet on
# whatever delegations you hand it. Must match VITE_YIELD_AGENT_ADDRESS's
# address above.
# AGENT_PRIVATE_KEY=0xyour_dedicated_yield_agent_private_key

# --- Strategy agent (scripts/strategy-agent.ts) ---
# NODE-SIDE ONLY, run locally by whoever operates the DCA agent. Never prefix with
# VITE_, never commit. Reuses AGENT_PRIVATE_KEY above (the delegate that redeems).
# The DCA rail runs on Base (8453) / Ethereum (1) mainnet — the Universal Router
# addresses and Uniswap liquidity live there, not on testnets. Set
# VITE_INTUITION_NETWORK=mainnet so the agent discovers mandates on the right graph.
#
# Uniswap Trading API key (x-api-key) — build the swap calldata. Get one from the
# Uniswap developer portal. Agent-side only; never ship to the browser.
# UNISWAP_API_KEY=your_uniswap_trading_api_key
# Optional RPC override (defaults to viem's public RPC for the chain).
# RPC_URL=https://your-rpc-endpoint
